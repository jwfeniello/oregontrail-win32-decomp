# User-supplied game media and anything extracted from it. The disc, the two
# shipped PE images, and every asset dumped out of them stay outside source
# control.
Sample/
resources/
original/

# Build and match artifacts. The candidate DLL, its map, and the matcher's
# results are all regenerated by harness-match.sh --build.
artifacts/
build/*
!build/report.json
out/
bin/
obj/

# The MSVC 4.0 toolchain is user-supplied and not redistributable.
msdev/
toolchain/

# Ghidra projects, inventories, and exported metrics.
tools/ghidra/

# Binary and link products
*.obj
*.pdb
*.ilk
*.idb
*.ipch
*.pch
*.exe
*.dll
*.lib
*.exp
*.map
*.res
*.log
*.suo
*.VC.db
*.VC.opendb

# MSVC /FA compiler listings (transient match-attempt artifacts)
*.asm

# Editors, assistants, worktrees, and local environment
.claude/
.codex/
.agents/
.cursor/
.idea/
.vs/
.vscode/
.worktrees/
.env
.env.*

# Python caches
__pycache__/
*.py[cod]
